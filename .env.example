# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-project-id
BT_INSTANCE_ID=your-instance-id
BT_TABLE_NAME=hashes

# Monitoring Configuration
MONITORING_ENDPOINT=http://your-monitoring-server.com/api/hashrate

# Performance Tuning
BATCH_SIZE=100
UPLOAD_BATCH_SIZE=1000
UPLOAD_INTERVAL=10
CPU_THREADS=4

# Resource Limits
MEM_LIMIT=4g
CPU_LIMIT=2.0

# GPU Configuration (use 'all' for all GPUs, or comma-separated indices like '0,1')
CUDA_VISIBLE_DEVICES=all
# GPU-optimized Dockerfile with proper CUDA support
FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04

# Install Python and essential packages
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Install CuPy for CUDA 11.x
RUN pip3 install --no-cache-dir cupy-cuda11x

# Copy application files
COPY hash_generator.py config.json credentials.json ./
COPY verify_hashgen.sh verify_inside_container.py ./
RUN chmod +x verify_hashgen.sh

# Set environment variables
ENV CONFIG_PATH=/app/config.json \
    GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json \
    CUDA_VISIBLE_DEVICES=all \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Run the application
CMD ["python3", "hash_generator.py"]